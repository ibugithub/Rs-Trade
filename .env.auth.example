# Admin path: change this value and restart Django.
ADMIN_URL=staff-portal/

# Optional additions to your existing .env; defaults already match these values.
# Account endpoint rate limits. All attempts count, including invalid submissions.
AUTH_LOGIN_RATE=10/min
AUTH_SIGNUP_RATE=5/hour
AUTH_PASSWORD_RESET_RATE=5/hour
AUTH_PASSWORD_RESET_EMAIL_RATE=3/hour
AUTH_VERIFICATION_RESEND_RATE=5/hour
AUTH_VERIFICATION_RESEND_EMAIL_RATE=3/hour
AUTH_RESET_CONFIRM_RATE=10/min
AUTH_EMAIL_VERIFY_RATE=20/min
# 0 ignores X-Forwarded-For. Set the actual trusted proxy count on your host.
AUTH_TRUSTED_PROXY_COUNT=0
